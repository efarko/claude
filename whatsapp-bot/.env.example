# Copia estos nombres en Vercel → tu proyecto → Settings → Environment Variables.

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Opcional. Por defecto claude-opus-5-5. Para gastar menos: claude-sonnet-5-5
CLAUDE_MODEL=

# WhatsApp (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
WHATSAPP_TOKEN=            # Token permanente de un usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=  # "Identificador del número de teléfono" (no es el número)
WHATSAPP_APP_SECRET=       # Configuración de la app → Básica → Clave secreta de la app
WHATSAPP_VERIFY_TOKEN=     # Inventa una palabra secreta; la misma va en la config del webhook
WHATSAPP_GRAPH_VERSION=v23.0

# Tu WhatsApp personal, donde recibes los avisos (formato internacional, sin + ni espacios)
OWNER_WHATSAPP=5215512345678
# Opcional: plantilla aprobada por Meta para avisarte aunque no hayas escrito al bot en 24 h
OWNER_ALERT_TEMPLATE=
OWNER_ALERT_TEMPLATE_LANG=es_MX

# Datos de tu negocio (también puedes editarlos en lib/negocio.ts)
NOMBRE_NEGOCIO=
NOMBRE_DUENO=
UBICACION_NEGOCIO=

# Redis (Upstash): se llenan solas al conectar Upstash desde el Marketplace de Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
